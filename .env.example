# Public Azure status feed; override if Microsoft changes the endpoint.
AZURE_STATUS_RSS_URL=https://azure.status.microsoft/en-us/status/feed/
RSS_TIMEOUT_SECONDS=10
RSS_MAX_RETRIES=1
INGESTION_INTERVAL_SECONDS=300
DASHBOARD_POLL_SECONDS=30
DATABASE_PATH=data/incidents.db

# Leave the key empty for deterministic fallback-only analysis.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LOG_LEVEL=INFO
