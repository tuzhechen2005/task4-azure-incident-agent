# Azure 公共状态订阅源；如果微软更改地址，可在此覆盖。
AZURE_STATUS_RSS_URL=https://azure.status.microsoft/en-us/status/feed/
RSS_TIMEOUT_SECONDS=10
RSS_MAX_RETRIES=1
INGESTION_INTERVAL_SECONDS=300
DASHBOARD_POLL_SECONDS=30
DATABASE_PATH=data/incidents.db

# 默认不调用模型；以下 Azure OpenAI 三项任一为空时使用确定性备用分析。
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LOG_LEVEL=INFO
